# ─────────────────────────────────────────────────────────────────────────────
# API Keys — copy this file to .env and fill in your keys
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI (required if using OpenAI models)
OPENAI_API_KEY=sk-...

# Google Gemini (alternative — set this if you don't have OpenAI)
GOOGLE_API_KEY=AIza...

# ─────────────────────────────────────────────────────────────────────────────
# Optional settings
# ─────────────────────────────────────────────────────────────────────────────

# Which model provider to use: "auto" | "openai" | "gemini"
# "auto" uses OpenAI if OPENAI_API_KEY is set, else falls back to Gemini
STUDY_MODEL=auto

# Path to the SQLite database for progress tracking
STUDY_DB_PATH=study_progress.db
